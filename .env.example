# ComaNet — copia este archivo a .env.local y completa con los valores de tu
# proyecto de Supabase (Dashboard > Project Settings > API).
# Crea un proyecto de Supabase NUEVO para ComaNet (no reutilices el de Stockia).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Llave service_role: SECRETA, solo en el servidor (crear usuarios y recibir
# pedidos públicos). Nunca al navegador ni a un repositorio público.
# Los usuarios y contraseñas NO van aquí: viven en la base de datos.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...